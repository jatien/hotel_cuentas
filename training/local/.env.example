# Copia este fichero a training/local/.env (no se sube a git) y ajusta las rutas.
# Antes del primer uso crea las carpetas con tu usuario (si no, Docker las crea como root):
#   mkdir -p ~/factura-ia/outputs ~/factura-ia/cache

# Dataset exportado con: python manage.py invoice_agent_export_dataset <carpeta>
DATASET_DIR=/home/TU_USUARIO/factura-ia/dataset_facturas
OUTPUTS_DIR=/home/TU_USUARIO/factura-ia/outputs
CACHE_DIR=/home/TU_USUARIO/factura-ia/cache

# Tu usuario del anfitrión (id -u / id -g), para que los ficheros generados sean tuyos
HOST_UID=1000
HOST_GID=1000

# Nombre de la ejecución: los resultados quedan en OUTPUTS_DIR/<RUN>/ (lora, merged, merged-fp8).
# Vacío: run1 con docker compose; pipeline.sh usa la fecha (run-AAAAMMDD-HHMM) para no pisar nada.
RUN=
# Límite de tokens por ejemplo. 8192 cabe en 16 GB; los ejemplos más largos se descartan.
MAX_SEQ_LEN=8192
# Opciones extra de train_qwen25vl.py, p. ej.: --epochs 2 --lr 5e-5 --resume
TRAIN_ARGS=

# Clave de la API de vLLM (la misma va en INVOICE_AGENT_API_KEY del .env de Django).
# Genera una con: python3 -c "import secrets; print(secrets.token_urlsafe(24))"
VLLM_API_KEY=
# Modelo a servir: el FP8 oficial del modelo base (línea base) o /outputs/<RUN>/merged-fp8
SERVE_MODEL=RedHatAI/Qwen2.5-VL-7B-Instruct-FP8-Dynamic
# 127.0.0.1 = solo este PC; la IP de este PC en la LAN para evaluar desde el PC del hotel
SERVE_BIND=127.0.0.1
MAX_MODEL_LEN=12288
GPU_MEMORY_UTILIZATION=0.88
# Imagen de vLLM; fija una versión concreta cuando una funcione bien con la RTX 5080
VLLM_IMAGE=vllm/vllm-openai:latest

# Solo si descargas modelos privados de Hugging Face
HF_TOKEN=

# --- Ciclo con Google Drive (pipeline.sh) -------------------------------------------------
# Remoto de rclone con la carpeta de facturas (PDF en subcarpetas + carpeta de JSON).
# Configúralo una vez con: rclone config  (tipo «drive», alcance de solo lectura NO: hay que subir JSON)
# Vacío = no sincronizar, usar lo que haya en DRIVE_DIR.
RCLONE_REMOTE=gdrive:Invoices
# Copia local de esa carpeta y nombre de la subcarpeta de los JSON
DRIVE_DIR=/home/TU_USUARIO/factura-ia/drive
LABELS_SUBDIR=Invoices_json
# Empresa que recibe las facturas (NIF dado de alta en Facturas con IA)
EMPRESA_NIF=B07794803
# Python del venv de Django (vacío = <repo>/.venv o <repo>/venv)
DJANGO_PY=
# Máximo de facturas nuevas que etiqueta el LLM grande en cada ejecución (vacío = todas)
MAX_EXTRACT=
