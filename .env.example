# Copia este fichero como .env (junto a manage.py) y rellena los valores.
# .env está en .gitignore: NUNCA subas claves reales a git.

# --- Entorno y Django ------------------------------------------------------
# dev  = desarrollo (DEBUG, runserver)
# prod = servidor real detrás de HTTPS (ver docs/security.md y deploy/)
DJANGO_ENV=dev

# Clave secreta. Obligatoria en prod; genera una con:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=
# Al rotarla, pon aquí la anterior (separadas por comas) para no cerrar sesiones de golpe.
SECRET_KEY_FALLBACKS=

# Nombres o IPs con los que se entra a la app, separados por comas. En prod no vale "*".
# Ejemplo LAN: localhost,127.0.0.1,pms.hotel.lan,192.168.1.20
# (en prod "localhost" hace falta para el health check del proxy)
ALLOWED_HOSTS=localhost,127.0.0.1
# Orígenes HTTPS que pueden enviar formularios (en prod se deducen de ALLOWED_HOSTS si se deja vacío).
CSRF_TRUSTED_ORIGINS=

# --- Proxy HTTPS (Caddy) ---------------------------------------------------
# Nombres/IPs del certificado, separados por coma y espacio (deploy/caddy/Caddyfile).
CUENTAS_HOSTS=pms.hotel.lan, 192.168.1.20
# IPs/redes de los proxies cuyas cabeceras X-Forwarded-* se aceptan. En prod por defecto 127.0.0.1;
# con Docker lo fija compose.yaml.
# TRUSTED_PROXIES=127.0.0.1
# Solo Docker: IP de la LAN donde se publican 80/443 y carpeta de datos (partición cifrada)
# CUENTAS_BIND_IP=192.168.1.20
# CUENTAS_DATA_DIR=/srv/cuentas

# --- Base de datos (PostgreSQL) -------------------------------------------
# Usa el rol cuentas_app (deploy/postgres/roles.sql) con contraseña larga, no "postgres".
DB_NAME=cuentas
DB_USER=postgres
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432

# --- Cifrado en reposo y copias de seguridad -------------------------------
# Claves Fernet de los campos cifrados (la primera cifra; al rotar: nueva,antigua).
#   python manage.py rotar_cifrado --generar-clave
FIELD_ENCRYPTION_KEYS=
# Clave del índice ciego para buscar en campos cifrados: python manage.py rotar_cifrado --generar-indice
BLIND_INDEX_KEY=
# Copias cifradas con age: SOLO la clave pública. La privada se guarda fuera del servidor.
#   python manage.py copia_seguridad --generar-clave
BACKUP_AGE_RECIPIENTS=
# Carpeta de las copias (por defecto <proyecto>/backups) y días que se guardan
# BACKUP_DIR=D:\copias-cuentas
BACKUP_KEEP_DAYS=30
# Carpeta de pg_dump si no está en el PATH (Windows)
# BACKUP_PG_BIN_DIR=C:\Program Files\PostgreSQL\17\bin
# TLS hacia PostgreSQL si está en otro equipo: verify-full + certificado de la CA
DB_SSLMODE=prefer
# DB_SSLROOTCERT=

# --- Llamadas salientes -------------------------------------------------
# Redes de WireGuard por las que http:// va cifrado (Tailscale ya se reconoce). Ej.: 10.8.0.0/24
OUTBOUND_VPN_NETWORKS=

# --- Seguridad web --------------------------------------------------------
# False = la Content Security Policy solo informa (logs/security.log); True = bloquea.
CSP_ENFORCE=False
# Solo prod: segundos de HSTS. Empieza en 3600 y sube a 31536000 cuando HTTPS funcione en todos los PCs.
SECURE_HSTS_SECONDS=3600
# Carpeta de logs (logs/security.log). Vacío = <proyecto>/logs
# LOG_DIR=

# Ruta a tesseract.exe si no está en el PATH (Windows)
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe

# --- Facturas con IA (invoice_agent) -------------------------------------
# Proveedor: "openai" sirve para OpenAI y para cualquier servidor compatible
# (Ollama, vLLM, LM Studio...) cambiando BASE_URL. "fake" = sin red (pruebas).
INVOICE_AGENT_PROVIDER=openai

# OpenAI en la nube: deja BASE_URL vacío y pon tu clave.
INVOICE_AGENT_API_KEY=sk-pon-aqui-tu-clave
INVOICE_AGENT_MODEL=gpt-4.1-mini
INVOICE_AGENT_BASE_URL=

# Servidor local (ejemplo con Ollama en otro PC de la red):
# INVOICE_AGENT_BASE_URL=http://192.168.1.50:11434/v1
# INVOICE_AGENT_API_KEY=
# INVOICE_AGENT_MODEL=qwen2.5vl:7b
# INVOICE_AGENT_SUPPORTS_VISION=True     # False si el modelo es solo de texto

# Enviar imágenes de páginas difíciles al modelo (solo si el texto no basta).
INVOICE_AGENT_ALLOW_VISION=True
# auto = imagen solo de páginas difíciles · always = todas las páginas (usar con el modelo
# Qwen2.5-VL afinado, igual que en el entrenamiento) · never = solo texto
INVOICE_AGENT_VISION_MODE=auto

# Precio por millón de tokens para la métrica de coste (consúltalo en tu proveedor; 0 = no calcular).
INVOICE_AGENT_PRICE_INPUT_PER_MTOK=0
INVOICE_AGENT_PRICE_OUTPUT_PER_MTOK=0

# Modelo «profesor» para entrenar el modelo local (invoice_agent_pipeline, training/README.md):
# un LLM grande que etiqueta las facturas nuevas. Vacío = el mismo modelo de arriba, así puedes
# poner arriba el Qwen afinado (producción) y seguir etiquetando con el grande. Ejemplo OpenRouter:
# INVOICE_AGENT_TEACHER_BASE_URL=https://openrouter.ai/api/v1
# INVOICE_AGENT_TEACHER_API_KEY=sk-or-...
# INVOICE_AGENT_TEACHER_MODEL=<modelo de visión grande>
INVOICE_AGENT_TEACHER_MODEL=
INVOICE_AGENT_TEACHER_BASE_URL=
INVOICE_AGENT_TEACHER_API_KEY=

# Trabajos simultáneos entre todos los workers.
INVOICE_AGENT_MAX_CONCURRENT_JOBS=2

# False = uso en la LAN sin usuarios (como el resto del proyecto).
# True  = hace falta iniciar sesión y cada usuario solo ve sus empresas.
INVOICE_AGENT_REQUIRE_LOGIN=False

# Días hasta que el original de una factura aprobada/rechazada se puede borrar (vacío = nunca).
INVOICE_AGENT_RETENTION_DAYS=

# --- Base de datos -------------------------------------------------------
# Solo para generar los datos de entrenamiento del copilot (training/copilot/README.md):
# DB_NAME=cuentas_ficticio

# --- PMS Copilot (copilot_pms) -------------------------------------------
# Modelo principal: Qwen3.5-9B servido con vLLM en el servidor local
# (ver copilot_pms/deploy/README.md). Tiene que admitir llamadas a funciones.
COPILOT_PROVIDER=openai
COPILOT_BASE_URL=http://IP-VPN-DEL-SERVIDOR:8000/v1
COPILOT_API_KEY=pon-aqui-la-VLLM_API_KEY-del-servidor
COPILOT_MODEL=Qwen/Qwen3.5-9B

# Muestreo recomendado por Qwen (modo sin razonamiento). Vacío = no se envía.
COPILOT_TEMPERATURE=0.7
COPILOT_TOP_P=0.8
COPILOT_TOP_K=20
COPILOT_PRESENCE_PENALTY=1.5
# True = Qwen razona antes de responder (más lento; probar con la evaluación).
COPILOT_ENABLE_THINKING=False

# Alternativa en la nube mientras no hay servidor (OpenAI):
# COPILOT_BASE_URL=
# COPILOT_API_KEY=sk-...
# COPILOT_MODEL=gpt-4.1-mini
# COPILOT_TEMPERATURE=0
# COPILOT_TOP_P=
# COPILOT_TOP_K=
# COPILOT_PRESENCE_PENALTY=

# True = hace falta iniciar sesión y cada consulta exige su permiso de Django.
COPILOT_REQUIRE_LOGIN=False
